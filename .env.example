# Public Traefik hostnames. These must resolve to the Docker host.
IMMICH_HOST=immich.example.xyz
PAGES_HOST=pages.example.xyz

# Required secrets. Generate both values; do not use these example values.
DB_PASSWORD=change-me
PAGES_SESSION_SECRET=change-me-to-at-least-32-random-characters
# Dedicated key for the encrypted, ref-only visited-share browser registry.
PAGES_VISITED_SHARES_SECRET=change-me-to-at-least-32-random-characters

# Trusted Immich origin. Pages never uses an owner credential for visitor requests.
IMMICH_BASE_URL=https://immich.example.xyz
# Immich compatibility target used by /health/immich.
IMMICH_SUPPORTED_VERSION=3.1.0

# Optional adapter-node settings for a reverse-proxy deployment.
HOST=0.0.0.0
PORT=3000
PROTOCOL_HEADER=X-Forwarded-Proto
HOST_HEADER=X-Forwarded-Host

# Deployment-owned MapLibre style for the approved quiet-atlas presentation.
# Album YAML selects the name, never an arbitrary URL.
MAP_STYLE_URL_QUIET_ATLAS=https://maps.example.xyz/styles/quiet-atlas.json

# Optional operator-owned BRouter endpoint override. By default the built-in
# adapter uses https://brouter.de/brouter and its https://brouter.de origin.
# Album URLs never select this target. If overriding, explicitly name the
# exact allowed origin (and optionally path).
# BROUTER_ENDPOINT=https://router.example.xyz/brouter
# BROUTER_ALLOWED_ORIGINS=https://router.example.xyz
# Optional response-body override in bytes. Default 262144; accepted range
# is 65536 through 8388608. Geometry validation limits still apply.
# BROUTER_MAX_RESPONSE_BYTES=1048576
# Set false to bypass the in-memory route cache and in-flight deduplication
# while testing route changes.
# BROUTER_CACHE_ENABLED=false
