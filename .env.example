# Public hostnames; both must resolve to this Docker host.
IMMICH_HOST=immich.example.xyz
PAGES_HOST=pages.example.xyz
# For the Let's Encrypt certificates Traefik requests.
LETSENCRYPT_EMAIL=you@example.xyz

# Required secrets. Generate each with: openssl rand -hex 32
DB_PASSWORD=change-me
PAGES_SESSION_SECRET=change-me
PAGES_VISITED_SHARES_SECRET=change-me

# Using compose.yaml (Pages alone) instead? It needs only the three Pages settings:
# IMMICH_BASE_URL=https://immich.example.xyz
# Every optional setting is listed in docs/deployment.md.
