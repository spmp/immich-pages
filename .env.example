# Trusted Immich origin. Pages never uses an owner credential for visitor requests.
# Dedicated authenticated-library locator key; generate a stable random value
# of at least 32 characters and never use a default or reuse the session key.
PAGES_LOCATOR_SECRET=change-me-to-at-least-32-random-characters
IMMICH_BASE_URL=https://immich.example.xyz
# Immich compatibility target used by /health/immich.
IMMICH_SUPPORTED_VERSION=3.1.0

# Optional adapter-node settings for a reverse-proxy deployment.
HOST=0.0.0.0
PORT=3000
PROTOCOL_HEADER=X-Forwarded-Proto
HOST_HEADER=X-Forwarded-Host

# Deployment-owned MapLibre style for the approved quiet-atlas presentation.
# Album YAML selects the name, never an arbitrary URL.
MAP_STYLE_URL_QUIET_ATLAS=https://maps.example.xyz/styles/quiet-atlas.json

# Optional operator-owned BRouter endpoint. The allowlist must explicitly name
# the exact origin (and optionally path); album URLs never select this target.
BROUTER_ENDPOINT=https://router.example.xyz/brouter
BROUTER_ALLOWED_ORIGINS=https://router.example.xyz
