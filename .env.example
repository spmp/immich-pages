# Trusted Immich origin. Pages never uses an owner credential for visitor requests.
IMMICH_BASE_URL=https://immich.example.xyz
# Immich compatibility target used by /health/immich.
IMMICH_SUPPORTED_VERSION=3.1.0

# Optional adapter-node settings for a reverse-proxy deployment.
HOST=0.0.0.0
PORT=3000
PROTOCOL_HEADER=X-Forwarded-Proto
HOST_HEADER=X-Forwarded-Host
