{
  "name": "immich-pages",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run && npm run test:component",
    "test:component": "vitest run --config vitest.component.config.ts",
    "dev": "vite dev",
    "build": "vite build",
    "e2e": "playwright test",
    "test:e2e": "node tests/e2e/run-traefik.mjs",
    "test:e2e:mock": "node tests/e2e/run-mock-immich.mjs",
    "test:e2e:heic:chromium": "HDR_METADATA_PATH=\"$PWD/tests/e2e/hdr-method-bridge.mjs\" HDR_COMPOSITOR_PATH=\"$PWD/tests/e2e/hdr-method-bridge.mjs\" HDR_FFMPEG_PATH=\"$PWD/tests/e2e/hdr-method-bridge.mjs\" HDR_BRIDGE_LOG=/tmp/immich-pages-hdr-bridge.log node tests/e2e/run-mock-immich.mjs tests/e2e/heic-sdr-hdr.mock.spec.ts",
    "test:e2e:heic:webkit": "MOCK_PLAYWRIGHT_CONFIG=playwright.mock.webkit.config.ts HDR_METADATA_PATH=\"$PWD/tests/e2e/hdr-method-bridge.mjs\" HDR_COMPOSITOR_PATH=\"$PWD/tests/e2e/hdr-method-bridge.mjs\" HDR_FFMPEG_PATH=\"$PWD/tests/e2e/hdr-method-bridge.mjs\" HDR_BRIDGE_LOG=/tmp/immich-pages-hdr-bridge.log node tests/e2e/run-mock-immich.mjs tests/e2e/heic-sdr-hdr.mock.spec.ts",
    "test:e2e:map": "PUBLIC_PAGES_DEBUG=true node tests/e2e/run-mock-immich.mjs --config=playwright.map.config.ts",
    "verify:immich-release": "node scripts/verify-immich-release.mjs",
    "test:stateless-recreate": "node scripts/test-stateless-recreate.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@sveltejs/kit": "2.70.3",
    "@testing-library/svelte": "5.4.2",
    "@types/node": "24.0.0",
    "happy-dom": "20.14.5",
    "svelte": "5.56.10",
    "svelte-check": "4.4.6",
    "typescript": "6.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  },
  "dependencies": {
    "@sveltejs/adapter-node": "5.5.7",
    "maplibre-gl": "^6.6.0",
    "node-vibrant": "^4.0.3",
    "photoswipe": "5.4.4",
    "rehype-sanitize": "6.0.0",
    "rehype-stringify": "10.0.1",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "unified": "11.0.5",
    "yaml": "2.9.0",
    "zod": "4.4.3"
  }
}
